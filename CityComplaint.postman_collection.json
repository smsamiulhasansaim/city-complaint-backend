        },
        {
          "name": "Expedite Complaint (citizen)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json().data;",
                  "if (d && d.sessionId) pm.collectionVariables.set('sessionId', d.sessionId);",
                  "if (d && d.payment && d.payment.id) pm.collectionVariables.set('paymentId', d.payment.id);",
                  "if (d && d.checkoutUrl) console.log('Open to pay: ' + d.checkoutUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/payments/complaints/{{complaintId}}/expedite", "host": ["{{baseUrl}}"], "path": ["api", "payments", "complaints", "{{complaintId}}", "expedite"] }
          }
        },
        {
          "name": "Confirm Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/confirm", "host": ["{{baseUrl}}"], "path": ["api", "payments", "confirm"] },
            "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}" }
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/payments?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "COMPLETED", "disabled": true },
                { "key": "purpose", "value": "SERVICE_REQUEST", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["api", "payments", "{{paymentId}}"] }
          }
        },
        {
          "name": "Stripe Webhook (reference only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "stripe-signature", "value": "t=...,v1=..." }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/webhook", "host": ["{{baseUrl}}"], "path": ["api", "payments", "webhook"] },
            "body": { "mode": "raw", "raw": "{}" },
            "description": "Do not send from Postman. Stripe posts here with a signed raw body. Use `stripe listen --forward-to localhost:5000/api/payments/webhook` in test mode."
          }
        }
      ]
    },
