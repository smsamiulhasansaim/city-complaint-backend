          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rakib Hasan\",\n  \"email\": \"newcitizen@example.com\",\n  \"password\": \"Citizen@1234\",\n  \"phone\": \"+8801700000009\",\n  \"ward\": \"Ward 5\"\n}"
            }
          }
        },
