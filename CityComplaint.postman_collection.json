  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "agentId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "complaintId", "value": "" },
    { "key": "serviceRequestId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "notificationId", "value": "" }
