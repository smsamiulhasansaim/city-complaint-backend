// City Complaint & Service Platform - Prisma schema
// Postgres. Run: `npm run prisma:migrate` then `npm run prisma:seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CITIZEN
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ComplaintStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  PENDING_PAYMENT
  PAID
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentProvider {
  STRIPE
  SSLCOMMERZ
  BKASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  SERVICE_REQUEST
  COMPLAINT_EXPEDITE
}

enum NotificationType {
  COMPLAINT
  SERVICE
  PAYMENT
  SYSTEM
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  password     String? // null for Google-only accounts
  googleId     String?      @unique
  authProvider AuthProvider @default(LOCAL)
  phone        String?
  address      String?
  ward         String?
  avatar       String?
  role         Role         @default(CITIZEN)
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  complaints              Complaint[]       @relation("CitizenComplaints")
  assignedComplaints      Complaint[]       @relation("AgentComplaints")
  complaintUpdates        ComplaintUpdate[] @relation("UpdateAuthor")
  serviceRequests         ServiceRequest[]  @relation("CitizenServiceRequests")
  assignedServiceRequests ServiceRequest[]  @relation("AgentServiceRequests")
  payments                Payment[]
  reviews                 Review[]
  notifications           Notification[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaints Complaint[]

  @@map("categories")
}

model Complaint {
  id          String          @id @default(uuid())
  title       String
  description String
  ward        String?
  address     String?
  latitude    Float?
  longitude   Float?
  images      String[]
  priority    Priority        @default(MEDIUM)
  status      ComplaintStatus @default(PENDING)
  isExpedited Boolean         @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  citizenId String
  citizen   User   @relation("CitizenComplaints", fields: [citizenId], references: [id])

  assignedAgentId String?
  assignedAgent   User?   @relation("AgentComplaints", fields: [assignedAgentId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  updates ComplaintUpdate[]
  review  Review?
  payment Payment?

  @@index([status])
  @@index([categoryId])
  @@index([citizenId])
  @@index([assignedAgentId])
  @@index([priority])
  @@index([createdAt])
  @@map("complaints")
}

model ComplaintUpdate {
  id         String           @id @default(uuid())
  fromStatus ComplaintStatus?
  toStatus   ComplaintStatus?
  note       String
  createdAt  DateTime         @default(now())

  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("UpdateAuthor", fields: [authorId], references: [id])

  @@index([complaintId])
  @@map("complaint_updates")
}

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  fee         Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests ServiceRequest[]

  @@map("services")
}

model ServiceRequest {
  id        String               @id @default(uuid())
  status    ServiceRequestStatus @default(PENDING_PAYMENT)
  details   String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  citizenId String
  citizen   User   @relation("CitizenServiceRequests", fields: [citizenId], references: [id])

  assignedAgentId String?
  assignedAgent   User?   @relation("AgentServiceRequests", fields: [assignedAgentId], references: [id])

  payment Payment?

  @@index([status])
  @@index([citizenId])
  @@index([serviceId])
  @@map("service_requests")
}

model Payment {
  id            String          @id @default(uuid())
  transactionId String          @unique // Stripe checkout session id
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("usd")
  method        String          @default("card")
  provider      PaymentProvider @default(STRIPE)
  status        PaymentStatus   @default(PENDING)
  purpose       PaymentPurpose
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  payerId String
  payer   User   @relation(fields: [payerId], references: [id])

  // Exactly one of the two below is set (enforced in application logic)
  serviceRequestId String?         @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  complaintId String?    @unique
  complaint   Complaint? @relation(fields: [complaintId], references: [id])

  @@index([payerId])
  @@index([status])
  @@map("payments")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int // 1..5
  comment   String
  createdAt DateTime @default(now())

  citizenId String
  citizen   User   @relation(fields: [citizenId], references: [id])

  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType @default(SYSTEM)
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
