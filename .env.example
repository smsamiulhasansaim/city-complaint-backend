# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated allowed origins for CORS (optional; defaults to "*")
CLIENT_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Local: postgresql://user:password@localhost:5432/city_complaint
# Neon (recommended for Vercel): postgresql://user:password@ep-xxx.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Google Social Login (GCP) ----
# OAuth 2.0 Client ID from Google Cloud Console (Web application)
GOOGLE_CLIENT_ID=

# ---- Stripe (use TEST keys for evaluation) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Fixed fee (in the store currency, e.g. USD) charged to expedite a complaint
EXPEDITE_FEE=20

# ---- Redis (optional; app runs without it) ----
# Upstash example: rediss://default:password@xxx.upstash.io:6379
REDIS_URL=

# ---- Seed / Demo admin ----
ADMIN_EMAIL=admin@citycomplaint.com
ADMIN_PASSWORD=Admin@1234
